    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f1f1f1;
    }

    header {
        background: #4c8f29;
        color: white;
        padding: 20px;
    }

    header h1 {
        margin: 0;
    }

    nav {
        margin-top: 10px;
    }

    nav a {
        color: white;
        text-decoration: none;
        margin-right: 20px;
    }

    .container {
        max-width: 1000px;
        margin: 30px auto;
        padding: 20px;
    }

    .welcome {
        background: white;
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 30px;
    }

    .people {
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(220px, 1fr)
        );

        gap: 20px;
    }

    .person {
        background: white;
        padding: 20px;
        text-align: center;
        border-radius: 15px;
        box-shadow: 0 3px 10px rgba(0,0,0,.1);
    }

    .person img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 50%;
    }

    .person h3 {
        margin-bottom: 5px;
    }

    .person p {
        color: #777;
    }

    .person a {
        display: inline-block;
        padding: 8px 15px;
        background: #4c8f29;
        color: white;
        border-radius: 8px;
        text-decoration: none;
img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
}